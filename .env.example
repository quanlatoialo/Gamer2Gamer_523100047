# Backend – sao chép thành backend/.env (giá trị mẫu, không phải secret thật)
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/gamer2gamer?replicaSet=rs0
JWT_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
SESSION_TTL_HOURS=168
FRONTEND_ORIGIN=http://localhost:3000
PAYMENT_PROVIDER=demo
ENABLE_DEMO_PAYMENTS=true
PLATFORM_FEE_BPS=0
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152
DEMO_DEPOSIT_MAX_CENTS=100000
RATE_LIMIT_DISABLED=false

# Frontend – sao chép thành frontend/.env.local nếu backend không chạy ở cổng 4000
BACKEND_URL=http://localhost:4000
